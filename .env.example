# Settings you may add to .env (generate-secrets.sh writes the secrets there).
# Everything here is optional; the defaults are shown.

# Where ports are published. 127.0.0.1: this machine only.
# APP_BIND=0.0.0.0 makes Panelarr reachable from your network.
#APP_BIND=127.0.0.1
#APP_PORT=8900
#ADMIN_BIND=127.0.0.1
#META_PORT=8901
#MIHON_PORT=8902

# The public URL of Panelarr, if it has one (https makes cookies Secure).
#PANELARR_BASE_URL=https://panelarr.example.com

# Connect the server to meta here instead of in the first-run wizard. The key
# is a meta client key with the admin scope (meta's admin, Clients).
#PANELARR_META_URL=http://meta:8901
#PANELARR_META_KEY=mtk_...

# Single sign-on with your OpenID Connect provider (README.md, "Single sign-on").
# Off unless PANELARR_OIDC_ISSUER is set; it needs PANELARR_BASE_URL. Use the
# issuer exactly as your provider publishes it, trailing / included.
#PANELARR_OIDC_ISSUER=https://id.example.com/application/o/panelarr/
#PANELARR_OIDC_CLIENT_ID=panelarr
# The client secret, read from a file (a Docker secret, see README.md). Never
# put the secret itself here. Leave it unset for a public client (PKCE only).
#PANELARR_OIDC_CLIENT_SECRET_FILE=/run/secrets/panelarr_oidc_client_secret
#PANELARR_OIDC_BUTTON_LABEL=Sign in with SSO
# Add groups if your provider sends the groups claim only for that scope.
#PANELARR_OIDC_SCOPES=openid profile email
# Comma-separated. With admin groups set, the provider decides who is admin:
# every single sign-on sets the role from them (the last admin stays admin).
#PANELARR_OIDC_ADMIN_GROUPS=panelarr-admins
#PANELARR_OIDC_ALLOWED_GROUPS=panelarr-users
# Who may sign in with a password: all, or admins (link everyone's login first).
#PANELARR_OIDC_LOCAL_LOGIN=all
# true creates a user on a first sign-in nobody is linked to; set allowed groups too.
#PANELARR_OIDC_AUTO_PROVISION=false
# local ends Panelarr's session; provider also signs out at the provider.
#PANELARR_OIDC_LOGOUT=local

# meta's search backend: postgres, typesense or meilisearch. Start the matching
# profile too (--profile search-typesense / search-meilisearch).
#META_SEARCH_BACKEND=postgres

# VPN for the vpn profile (gluetun). See https://github.com/qdm12/gluetun-wiki
# for your provider's settings.
#VPN_SERVICE_PROVIDER=mullvad
#VPN_TYPE=wireguard
#WIREGUARD_PRIVATE_KEY=...
#WIREGUARD_ADDRESSES=10.64.0.2/32
#OPENVPN_USER=
#OPENVPN_PASSWORD=
#VPN_SERVER_COUNTRIES=Netherlands
# Optional credentials for gluetun's HTTP proxy (it is reachable inside this
# stack's network only).
#GLUETUN_PROXY_USER=
#GLUETUN_PROXY_PASSWORD=

# Image tags, when published images exist.
#META_TAG=dev
#MANGABAKA_TAG=dev
#MIHON_TAG=dev
#SOURCE_MIHON_TAG=dev
#SERVER_TAG=dev

# The built web app the server image embeds (default ../web/dist).
#WEB_DIST=../web/dist
