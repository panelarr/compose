# Settings you may add to .env (generate-secrets.sh writes the secrets there).
# Everything here is optional; the defaults are shown.

# Where ports are published. 127.0.0.1: this machine only.
# APP_BIND=0.0.0.0 makes Panelarr reachable from your network.
#APP_BIND=127.0.0.1
#APP_PORT=8900
#ADMIN_BIND=127.0.0.1
#META_PORT=8901
#MIHON_PORT=8902

# The public URL of Panelarr, if it has one (https makes cookies Secure).
#PANELARR_BASE_URL=https://panelarr.example.com

# Connect the server to meta here instead of in the first-run wizard. The key
# is a meta client key with the admin scope (meta's admin, Clients).
#PANELARR_META_URL=http://meta:8901
#PANELARR_META_KEY=mtk_...

# meta's search backend: postgres, typesense or meilisearch. Start the matching
# profile too (--profile search-typesense / search-meilisearch).
#META_SEARCH_BACKEND=postgres

# VPN for the vpn profile (gluetun). See https://github.com/qdm12/gluetun-wiki
# for your provider's settings.
#VPN_SERVICE_PROVIDER=mullvad
#VPN_TYPE=wireguard
#WIREGUARD_PRIVATE_KEY=...
#WIREGUARD_ADDRESSES=10.64.0.2/32
#OPENVPN_USER=
#OPENVPN_PASSWORD=
#VPN_SERVER_COUNTRIES=Netherlands
# Optional credentials for gluetun's HTTP proxy (it is reachable inside this
# stack's network only).
#GLUETUN_PROXY_USER=
#GLUETUN_PROXY_PASSWORD=

# Image tags, when published images exist.
#META_TAG=dev
#MANGABAKA_TAG=dev
#MIHON_TAG=dev
#SOURCE_MIHON_TAG=dev
#SERVER_TAG=dev

# The built web app the server image embeds (default ../web/dist).
#WEB_DIST=../web/dist
